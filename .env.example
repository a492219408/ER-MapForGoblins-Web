APP_PORT=8080
ASSETS_PORT=8081
BRIDGE_PORT=51337

# Read-only Bridge mount. For another device, use the host's LAN IP or .local name.
BRIDGE_SAVE_DIRECTORY=./runtime/saves
BRIDGE_SAVE_PATH=/saves/ER0000.sl2
BRIDGE_ADVERTISE_HOST=localhost

# Empty base URL means same-origin /assets; a separate asset host can use a full URL.
MFG_ASSET_BASE_URL=
MFG_ASSETS_DIRECTORY=/opt/mfg/assets

# Optional frontend asset host (Vite build-time setting).
VITE_MFG_ASSET_BASE_URL=

# Offline tools do not automatically read this file. Export these variables
# in your shell or use --reference / --unpacked / --witchy / --ffdec arguments.
# MFG_ERR_MAP_REFERENCE=/path/to/ERR-MapForGoblins-DLL
# MFG_ER_UNPACKED=/path/to/unpacked/game-version
# MFG_WITCHY_BND=/path/to/WitchyBND.exe
# MFG_FFDEC_JAR=/path/to/ffdec.jar
